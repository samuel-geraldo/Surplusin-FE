# SurplusIn Environment Variables
# Copy this file to .env and fill in the values.

VITE_API_BASE_URL=http://localhost:3000/api
VITE_APP_NAME=SurplusIn

# Optional map/geocoding overrides.
# Default tiles use CARTO light raster. Default geocoding uses Nominatim public API for dev only.
# Production recommendation: point geocoding to your backend proxy or paid provider with autocomplete.
# VITE_MAP_TILE_URLS=https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png,https://b.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png,https://c.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png,https://d.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png
# VITE_GEOCODING_SEARCH_URL=http://localhost:3000/api/geocoding/search
